[Unit]
Description=Xingyuan private database and photo backup
After=xingyuan-assistant.service

[Service]
Type=oneshot
User=xingyuan
Group=xingyuan
WorkingDirectory=/opt/xingyuan/current
ExecStart=/opt/xingyuan/current/server/build/backup/bundle/bin/backup create --config /etc/xingyuan/assistant-server.json --root /var/lib/xingyuan/backups
UMask=0077
StateDirectory=xingyuan
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=512M
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
