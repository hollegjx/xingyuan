  "fixed_sql": [
    {
      "name": "goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goals\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"owner\" TEXT NOT NULL DEFAULT 'guest', \"kind\" INTEGER NOT NULL CHECK(\"kind\" BETWEEN 0 AND 1), \"created_day\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"archived_day\" TEXT NULL, \"archived_at\" INTEGER NULL, UNIQUE (\"id\", \"kind\"));"
        }
      ]
    },
    {
      "name": "goal_titles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goal_titles\" (\"goal_id\" INTEGER NOT NULL REFERENCES goals (id), \"effective_day\" TEXT NOT NULL, \"title\" TEXT NOT NULL CHECK(LENGTH(\"title\") > 0), PRIMARY KEY (\"goal_id\", \"effective_day\"));"
        }
      ]
    },
    {
      "name": "goal_schedules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goal_schedules\" (\"goal_id\" INTEGER NOT NULL REFERENCES goals (id), \"effective_day\" TEXT NOT NULL, \"weekdays\" INTEGER NOT NULL CHECK(\"weekdays\" BETWEEN 0 AND 127), \"planned_day\" TEXT NULL, PRIMARY KEY (\"goal_id\", \"effective_day\"));"
        }
      ]
    },
    {
      "name": "check_ins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"check_ins\" (\"goal_id\" INTEGER NOT NULL REFERENCES goals (id), \"goal_kind\" INTEGER NOT NULL, \"occurrence_key\" TEXT NOT NULL, \"completed\" INTEGER NOT NULL CHECK (\"completed\" IN (0, 1)), \"completed_day\" TEXT NOT NULL, \"completed_at\" INTEGER NOT NULL, \"zone\" TEXT NOT NULL, \"title_snapshot\" TEXT NOT NULL, \"planned_day\" TEXT NULL, PRIMARY KEY (\"goal_id\", \"occurrence_key\"), FOREIGN KEY (goal_id, goal_kind) REFERENCES goals (id, kind), CHECK ((goal_kind = 1 AND occurrence_key = 'once') OR (goal_kind = 0 AND occurrence_key = completed_day)));"
        }
      ]
    },
    {
      "name": "goal_reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goal_reminders\" (\"goal_id\" INTEGER NOT NULL REFERENCES goals (id), \"enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"enabled\" IN (0, 1)), \"minute_of_day\" INTEGER NOT NULL DEFAULT 1200 CHECK(\"minute_of_day\" BETWEEN 0 AND 1439), \"revision\" INTEGER NOT NULL DEFAULT 0, \"needs_reconcile\" INTEGER NOT NULL DEFAULT 1 CHECK (\"needs_reconcile\" IN (0, 1)), \"status\" TEXT NOT NULL DEFAULT 'disabled', PRIMARY KEY (\"goal_id\"));"
        }
      ]
    }
  ]
